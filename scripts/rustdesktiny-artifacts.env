# RustDeskTiny 发布产物钉版。
#
# 构建脚本（build-windows.ps1 / build-linux-gui.sh / build-macos.sh）对
# src-tauri/resources/ 下的 RustDeskTiny 产物遵循同一策略：
#   - 本地文件已存在时直接复用（本地构建、自建产物不受影响）；
#   - 文件缺失时（Jenkins / GitHub Actions 等干净环境）按本文件钉版的
#     版本与 SHA-256 从 GitHub Release 自动下载并校验。
# 升级 RustDeskTiny / RustDeskTinyLegacy 时：更新对应仓库的版本号与 SHA-256
# （sha256sum <下载后的资产>），本地旧产物需手动删除才会触发重新下载。
#
# 资产命名规则（由脚本按版本推导；linux 的 Release 资产名带版本号，
# 但本地保存名固定为 RustDeskTiny.deb，与 repack-linux-gui-deb.sh 约定一致）：
#   windows-x64        -> RustDeskTiny-install.exe
#   windows-win7-x64   -> RustDeskTinyLegacy-install.exe（Legacy 独立仓库，版本线分开）
#   linux-amd64        -> RustDeskTiny-<version>.deb（保存为 RustDeskTiny.deb）
#   macos-x86_64       -> RustDeskTiny-macos-x86_64.zip
#   macos-aarch64      -> RustDeskTiny-macos-aarch64.zip
RUSTDESK_TINY_VERSION=1.5.1
RUSTDESK_TINY_BASE_URL=https://github.com/p2premote/rustdeskTiny/releases/download
RUSTDESK_TINY_WINDOWS_X64_SHA256=58ec1fc928c52b26473a2e7df14c7c0250edcfa754c3138142330065f2d46a71
RUSTDESK_TINY_LINUX_AMD64_SHA256=ae528352c7719c19b040d6037a8e5b173be6e04c9eb7df476060a2a034979701
RUSTDESK_TINY_MACOS_X86_64_SHA256=87d9294ebce8523b4e0f6e7e20f2f7015830b917c8fa2ed0e8974118e0214697
RUSTDESK_TINY_MACOS_AARCH64_SHA256=d5296c05cbdd5566c6ceef839ba7622ac7782932b6c489b4e73f285541808e25
RUSTDESK_TINY_LEGACY_VERSION=1.3.7
RUSTDESK_TINY_LEGACY_BASE_URL=https://github.com/p2premote/RustDeskTinyLegacy/releases/download
RUSTDESK_TINY_WINDOWS_WIN7_X64_SHA256=985c013d23700ffd4c0dde9efbfae169bd6cfa97116ef8b2e6224950929155a7
