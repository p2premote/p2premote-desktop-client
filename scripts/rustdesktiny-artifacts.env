# RustDeskTiny 发布产物钉版。
#
# 构建脚本（build-windows.ps1 / build-linux-gui.sh / build-macos.sh）对
# src-tauri/resources/ 下的 RustDeskTiny 产物遵循同一策略：
#   - 本地文件已存在时直接复用（本地构建、自建产物不受影响）；
#   - 文件缺失时（Jenkins / GitHub Actions 等干净环境）按本文件钉版的
#     版本与 SHA-256 从 GitHub Release 自动下载并校验。
# 升级 RustDeskTiny / RustDeskTinyLegacy 时：更新对应仓库的版本号与 SHA-256
# （sha256sum <下载后的资产>），本地旧产物需手动删除才会触发重新下载。
#
# 资产命名规则（由脚本按版本推导；linux 的 Release 资产名带版本号，
# 但本地保存名固定为 RustDeskTiny.deb，与 repack-linux-gui-deb.sh 约定一致）：
#   windows-x64        -> RustDeskTiny-install.exe
#   windows-win7-x64   -> RustDeskTinyLegacy-install.exe（Legacy 独立仓库，版本线分开）
#   linux-amd64        -> RustDeskTiny-<version>.deb（保存为 RustDeskTiny.deb）
#   macos-x86_64       -> RustDeskTiny-macos-x86_64.zip
#   macos-aarch64      -> RustDeskTiny-macos-aarch64.zip
RUSTDESK_TINY_VERSION=1.5.1
RUSTDESK_TINY_BASE_URL=https://github.com/p2premote/rustdeskTiny/releases/download
# macOS 单独钉在 1.5.2：该 tag 修复了 mac service 二进制 APP_NAME 用默认值
# "RustDesk" 的问题（ipc_service socket/配置目录与原生 RustDesk 冲突、
# agent 连不上 daemon；已实测 write-plists 产 Tiny 名）。1.5.2 打 tag 时仓库
# 版本文件未按惯例 bump，deb 资产名仍是 RustDeskTiny-1.5.1.deb，因此
# windows/linux 维持 1.5.1——service.rs 是 macOS 专属代码，两平台内容与
# 1.5.2 无功能差异。1.5.1 的 macos-aarch64.zip 内容实为 x86_64（上传错误）
# 的问题在 1.5.2 已消失（两 zip 架构实测验证过）。
RUSTDESK_TINY_MACOS_VERSION=1.5.2
RUSTDESK_TINY_WINDOWS_X64_SHA256=58ec1fc928c52b26473a2e7df14c7c0250edcfa754c3138142330065f2d46a71
RUSTDESK_TINY_LINUX_AMD64_SHA256=ae528352c7719c19b040d6037a8e5b173be6e04c9eb7df476060a2a034979701
RUSTDESK_TINY_MACOS_X86_64_SHA256=8d7ca5d017dd502bd091621ceba93adb733da8ebe4143d41ba84ed1a73f21b56
RUSTDESK_TINY_MACOS_AARCH64_SHA256=f761914da30ba17d63139f4b92cb77d813f77bf4a2793a8d14bcaba396384eed
RUSTDESK_TINY_LEGACY_VERSION=1.3.7
RUSTDESK_TINY_LEGACY_BASE_URL=https://github.com/p2premote/RustDeskTinyLegacy/releases/download
RUSTDESK_TINY_WINDOWS_WIN7_X64_SHA256=985c013d23700ffd4c0dde9efbfae169bd6cfa97116ef8b2e6224950929155a7
# WebView2 Runtime v109（Win7/8 最后版本）离线安装载荷。
# 该 exe 是浏览器/WebView2 共享 mini_installer 载荷：装成什么由参数决定，
# 必须带 --msedgewebview（裸跑会默认装出 Edge 浏览器），且不能带 /silent、
# /install——两者会被 WebView setup 以退出码 53 拒绝（"unsupported switch
# for WebView"，实机 msedge_installer.log 亲证）。已在真机验证成功的完整
# 参数集见 build-windows-win7.ps1。
# 140MB 超 GitHub 单文件 100MB 上限，拆两片入库 packaging/webview2-v109/
# （webview2-v109.exe.part-00/01.bin）；fetch-rustdesktiny-artifact.ps1 的
# webview2-win7-x64 kind 在 ../webview/ 缺失时按序拼接分片并按下方 SHA-256 校验。
WEBVIEW2_WIN7_X64_VERSION=109.0.1518.140
WEBVIEW2_WIN7_X64_SHA256=70d496873a0a1ca14ae0a038d25856b2121b1b4b7bad9801ce639b144bac41f8
