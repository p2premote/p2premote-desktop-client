// p2pRemote service configuration example (JSONC).
// The service accepts // and /* ... */ comments and trailing commas.
// Copy this file to C:\Program Files\p2pRemote\data\config.json, then replace
// placeholder values. Do not share or commit a real config.json: it can contain
// access tokens and saved credentials.
{
  // Platform API endpoint. Login and update-policy requests use this address.
  "server_url": "https://cli.p2premote.top",

  // Login state, maintained by the client. Keep null in a hand-created config.
  "auth_token": null,
  "refresh_token": null,
  "access_token_expires_at": null,
  "user_email": null,
  "device_id": null,
  "device_uuid": null,

  // Device-clone detection metadata, maintained by the client.
  "device_fingerprint": null,
  "device_fingerprint_platform": null,
  "device_fingerprint_version": 0,

  // Bundled component paths. Leave empty/default unless diagnosing an install.
  "wg_path": "",
  "wireguard_path": "",
  "p2p_punch_path": "",
  "log_level": "info",

  // Service and login behavior.
  "auto_start": false,
  "remember_me": false,
  "auto_login": false,

  // WGVPN LAN forwarding. CIDRs only take effect when enabled is true.
  "wgvpn_lan_access_enabled": false,
  "wgvpn_lan_cidrs": [],

  // Interface language: "zh-CN" or "en". Use null for automatic detection.
  "locale": "zh-CN",

  // WebUI master switch. false means the service does not listen on port 48083.
  // Use `p2premote-cli config set webui_enabled true|false` to change it;
  // that command restarts the service so the setting takes effect immediately.
  "webui_enabled": true,

  // WebUI access boundary:
  // - null: only local http://127.0.0.1:48083 is accepted.
  // - a single LAN IP: the service listens for that exact remote client.
  //   In this case web_admin_security_code must be a non-empty access code.
  "web_admin_allowed_ip": null,
  "web_admin_security_code": null,

  // Public-network check cache, maintained by the service. Do not edit manually.
  "cached_public_ip": null,
  "cached_public_ip_location": null,
  "cached_public_network_checked_at": 0,
}
