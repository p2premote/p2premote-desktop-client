{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "p2pRemote",
  "version": "1.3.26-54e0f7",
  "identifier": "top.p2premote.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/prepare-web-resources.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "p2pRemote",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "resources/p2premote-service.exe",
      "resources/p2premote-cli.exe",
      "resources/p2premote-notifier.exe",
      "resources/wintun.dll",
      "resources/p2premote-punch.dll",
      "resources/.p2premote_default.json",
      "resources/web/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer.nsh"
      }
    }
  }
}
