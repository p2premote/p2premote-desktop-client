{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "p2pRemote",
        "width": 1000,
        "height": 700,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "devtools": true
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "rpm"],
    "resources": [
      "resources/p2premote-service",
      "resources/p2premote-cli",
      "resources/.p2premote_default.json",
      "resources/web/**/*"
    ]
  }
}
