{
  "$schema": "https://schema.tauri.app/config/1",
  "tauri": {
    "windows": [
      {
        "title": "p2pRemote",
        "width": 1000,
        "height": 700,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Visible"
      }
    ],
    "bundle": {
      "targets": ["app"],
      "resources": [
        "resources/p2premote-service",
        "resources/p2premote-cli",
        "resources/RustDeskTiny.app/**/*",
        "resources/libp2premote-punch.dylib",
        "resources/.p2premote_default.json",
        "resources/web/**/*"
      ],
      "macOS": {
        "minimumSystemVersion": "13.0",
        "entitlements": "Entitlements.plist"
      }
    }
  }
}
