{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "title": "p2pRemote",
        "width": 1000,
        "height": 700,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "devtools": true
      }
    ]
  },
  "bundle": {
    "targets": ["dmg"],
    "resources": [
      "resources/p2premote-service",
      "resources/p2premote-cli",
      "resources/libp2premote-punch.dylib",
      "resources/.p2premote_default.json",
      "resources/web/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "files": {
        "Library/LaunchDaemons/top.p2premote.service.plist": "macos/top.p2premote.service.plist"
      }
    }
  }
}
